# =============================================================================
# VELORA — Environment Variables
# =============================================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# =============================================================================

# --- Database (Neon or Supabase Postgres) ---
# Also stores uploaded files (StoredFile table), so no separate storage service is needed.
# On Vercel use the pooled connection string:
#   Neon:     the "-pooler" host
#   Supabase: port 6543 with ?pgbouncer=true
DATABASE_URL="postgresql://user:password@host:5432/velora?sslmode=require"

# --- Authentication (NextAuth.js) ---
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"

# Google OAuth (Web)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- AI Providers (server-side only; a provider without a key is skipped) ---
# Allowed: OpenAI gpt-4o-mini / gpt-4o, DeepSeek, Groq. Routing lives in
# apps/web/src/lib/ai/models.ts: everyday -> gpt-4o-mini, images -> gpt-4o,
# reasoning/coding -> DeepSeek, live answers -> Groq; one fallback on failure.
AI_BASE_URL="https://api.openai.com/v1"
AI_API_KEY=""
# Everyday model; must be gpt-4o-mini (default) or gpt-4o.
AI_MODEL="gpt-4o-mini"
# Optional fixed model for desktop practice requests; empty = routing decides.
PRACTICE_AI_MODEL=""

# DeepSeek (cost-efficient reasoning and coding). deepseek-flash or deepseek-v4-pro.
DEEPSEEK_API_KEY=""
DEEPSEEK_BASE_URL="https://api.deepseek.com"
DEEPSEEK_MODEL="deepseek-flash"

# Groq (low-latency live answers). openai/gpt-oss-120b or openai/gpt-oss-20b.
GROQ_API_KEY=""
GROQ_BASE_URL="https://api.groq.com/openai/v1"
GROQ_MODEL="openai/gpt-oss-120b"

# --- Billing (Dodo Payments) ---
DODO_API_KEY=""
DODO_WEBHOOK_SECRET=""
DODO_PRODUCT_PLUS=""
DODO_PRODUCT_PRO=""

# --- Application ---
APP_URL="http://localhost:3000"
# Don't set NODE_ENV: Next.js sets it (development for `next dev`, production for builds).

# --- Analytics (optional) ---
# ANALYTICS_WRITE_KEY=""
