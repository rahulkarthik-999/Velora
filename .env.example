# =============================================================================
# VELORA — Environment Variables
# =============================================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# =============================================================================

# --- Database (Neon or Supabase Postgres) ---
# Also stores uploaded files (StoredFile table), so no separate storage service is needed.
# On Vercel use the pooled connection string:
#   Neon:     the "-pooler" host
#   Supabase: port 6543 with ?pgbouncer=true
DATABASE_URL="postgresql://user:password@host:5432/velora?sslmode=require"

# --- Authentication (NextAuth.js) ---
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"

# Google OAuth (Web)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- AI Provider ---
AI_PROVIDER="openai"
AI_BASE_URL="https://api.openai.com/v1"
AI_API_KEY=""
AI_MODEL="gpt-4o"
AI_FALLBACK_MODEL="gpt-4o-mini"
# Model for desktop interview practice (questions, feedback, resume extraction).
# A small, cheap model works well; defaults to AI_FALLBACK_MODEL.
PRACTICE_AI_MODEL=""

# --- Billing (Dodo Payments) ---
DODO_API_KEY=""
DODO_WEBHOOK_SECRET=""
DODO_PRODUCT_PLUS=""
DODO_PRODUCT_PRO=""

# --- Application ---
APP_URL="http://localhost:3000"
NODE_ENV="development"

# --- Analytics (optional) ---
# ANALYTICS_WRITE_KEY=""
