{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Velora",
  "version": "0.4.0",
  "identifier": "online.veloraweb.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Velora",
        "width": 1180,
        "height": 760,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "contentProtected": true
      },
      {
        "label": "copilot",
        "create": false,
        "title": "Velora Copilot",
        "url": "index.html",
        "width": 420,
        "height": 640,
        "minWidth": 340,
        "minHeight": 420,
        "visible": false,
        "alwaysOnTop": true,
        "decorations": false,
        "resizable": true,
        "skipTaskbar": false,
        "transparent": true,
        "shadow": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost https://api.veloraweb.online"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "headerImage": "installer/header.bmp",
        "sidebarImage": "installer/sidebar.bmp",
        "startMenuFolder": "Velora",
        "displayLanguageSelector": false,
        "compression": "lzma"
      },
      "allowDowngrades": false
    },
    "publisher": "Velora",
    "copyright": "Copyright (c) 2026 Velora",
    "homepage": "https://veloraweb.online",
    "category": "Productivity",
    "shortDescription": "Velora interview copilot",
    "longDescription": "Prepare for interviews and get real-time answer suggestions grounded in your own resume and notes."
  },
  "mainBinaryName": "Velora"
}
