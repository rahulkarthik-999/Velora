    "db:studio": "prisma studio",
    "clean": "rimraf .next .turbo"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.0.0",
    "@prisma/client": "^6.0.0",
    "@velora/schemas": "workspace:*",
