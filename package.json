{
  "name": "velora",
  "private": true,
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "test": "turbo test",
    "lint": "turbo lint",
    "type-check": "turbo type-check",
    "db:generate": "pnpm --filter @velora/web db:generate",
    "db:push": "pnpm --filter @velora/web db:push",
    "db:migrate": "pnpm --filter @velora/web db:migrate",
    "db:studio": "pnpm --filter @velora/web db:studio",
    "clean": "turbo clean"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "esbuild",
      "unrs-resolver"
    ]
  },
  "devDependencies": {
    "turbo": "^2.4.0",
    "typescript": "^5.7.0"
  }
}
